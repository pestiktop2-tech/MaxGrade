
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MaxGrade — помощник по оценкам</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  min-height: 100vh;
  padding: 25px 16px;
  background: #0b1020;
  color: #f4f6ff;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
}
.card {
  width: 100%;
  max-width: 430px;
  background: #151d32;
  border: 1px solid #293653;
  border-radius: 22px;
  padding: 26px;
  box-shadow: 0 15px 45px #0005;
}
h1 { margin: 0 0 8px; font-size: 30px; }
.subtitle { color: #9eabc7; margin-bottom: 25px; }
label {
  display: block;
  margin: 17px 0 8px;
  color: #dce4fa;
  font-size: 14px;
}
input, select {
  width: 100%;
  padding: 14px;
  border: 1px solid #344362;
  border-radius: 12px;
  background: #0e1629;
  color: white;
  font-size: 16px;
  outline: none;
}
button {
  width: 100%;
  padding: 15px;
  margin-top: 23px;
  border: 0;
  border-radius: 12px;
  background: #647cff;
  color: white;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}
button:active { transform: scale(.98); }
#result {
  display: none;
  margin-top: 20px;
  padding: 17px;
  border-radius: 13px;
  background: #202d49;
  line-height: 1.6;
}
.footer {
  margin-top: 22px;
  color: #7f8ba7;
  text-align: center;
  font-size: 12px;
}
</style>
</head>
<body>
<div class="card">
  <h1>MaxGrade</h1>
  <div class="subtitle">Помощник для расчёта школьных оценок</div>

  <label for="avg">Текущий средний балл</label>
  <input id="avg" type="number" min="2" max="5" step="0.01" placeholder="Например, 3.35">

  <label for="count">Количество оценок в дневнике</label>
  <input id="count" type="number" min="1" step="1" placeholder="Например, 6">

  <label for="target">Желаемая четвертная оценка</label>
  <select id="target">
    <option value="3">3 — Удовлетворительно</option>
    <option value="4" selected>4 — Хорошо</option>
    <option value="5">5 — Отлично</option>
  </select>

  <button onclick="calculate()">Рассчитать план</button>

  <div id="result"></div>

  <div class="footer">MaxGrade © 2026</div>
</div>

<script>
function calculate() {
  const avg = Number(document.getElementById('avg').value);
  const count = Number(document.getElementById('count').value);
  const target = Number(document.getElementById('target').value);
  const result = document.getElementById('result');

  if (!Number.isFinite(avg) || avg < 2 || avg > 5 ||
      !Number.isInteger(count) || count < 1) {
    result.style.display = 'block';
    result.innerHTML = 'Проверь введённые данные. Средний балл должен быть от 2 до 5, количество оценок — целым числом больше нуля.';
    return;
  }

  let needed = 0;

  while ((avg * count + 5 * needed) / (count + needed) < target - 0.000001) {
    needed++;
    if (needed > 10000) break;
  }

  result.style.display = 'block';

  if (avg >= target) {
    result.innerHTML = '<b>Отлично!</b><br>Твой средний балл уже достигает выбранной цели. Продолжай в том же духе!';
  } else if (needed > 10000) {
    result.innerHTML = 'Не удалось рассчитать результат.';
  } else {
    result.innerHTML =
      '<b>Твой план:</b><br>Чтобы средний балл достиг ' + target +
      ', тебе понадобится примерно <b>' + needed +
      ' пятёрок</b> подряд.<br><br>' +
      'Новый средний балл: <b>' +
      ((avg * count + 5 * needed) / (count + needed)).toFixed(2) +
      '</b>';
  }
}
</script>
</body>
</html>
